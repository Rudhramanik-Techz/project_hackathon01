# Copy to .env for local development. Never commit .env.
# Adapters: switching local -> cloud is configuration, not code.
STORE=memory                 # memory | dynamodb
OCR_PROVIDER=mock            # mock | textract
LLM_PROVIDER=mock            # off | mock | bedrock  (explain only sees rule IDs, never the message)

# Used only when an adapter talks to AWS from your laptop (your named CLI profile, no keys here).
AWS_PROFILE=asli
AWS_REGION=ap-south-1

# India geographic inference profile: processing stays in ap-south-1 / ap-south-2.
BEDROCK_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0

# Credit-drain protection (per UTC day, enforced atomically in the ledger)
LLM_DAILY_CAP=100
OCR_DAILY_CAP=150

# Admission ledger table (only used when STORE=dynamodb)
TABLE_NAME=asli-ledger

# Memory ledger only: local kill switch for paid OCR (on AWS: scripts/ocr_switch.py on|off)
OCR_ENABLED=1
